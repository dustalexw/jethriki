<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>Jethriki</AssemblyName><RootNamespace>YtdlpStudio.Linux</RootNamespace><Version>2.5.0</Version>
    <Company>Jethriki</Company><Product>Jethriki</Product>
    <Description>Linux video and audio downloader</Description>
    <ApplicationIcon>../../Windows/App/AppIcon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Windows/Core/YtdlpStudio.Core.csproj" />
    <AvaloniaResource Include="../../Assets/AppIcon.png" Link="Assets/AppIcon.png" />
  </ItemGroup>
</Project>
